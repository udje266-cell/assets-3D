{
  "expo": {
    "name": "Mobilité Chauffeur",
    "slug": "mobilite-chauffeur",
    "scheme": "mobilitechauffeur",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1a7f4b",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ci.mobilite.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Votre position permet de vous proposer les courses proches et de guider le client jusqu’à vous.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Votre position continue de remonter pendant une course afin que le client suive votre trajet, même écran éteint.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "ci.mobilite.driver",
      "adaptiveIcon": {
        "backgroundColor": "#1a7f4b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position permet de vous proposer les courses proches.",
          "locationAlwaysAndWhenInUsePermission": "Votre position remonte pendant une course pour que le client suive votre trajet.",
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
