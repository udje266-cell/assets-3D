# ---------------------------------------------------------------------------
# Configuration de la plateforme — copier vers .env et adapter
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Base de données PostgreSQL
DATABASE_URL=postgres://mobilite:mobilite@localhost:5432/mobilite

# Secrets JWT (générer avec: openssl rand -hex 32)
JWT_SECRET=change-me-en-production-32-caracteres-minimum
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Authentification par OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# En développement l'OTP est renvoyé dans la réponse HTTP et journalisé.
# Mettre à false en production : l'OTP ne doit transiter que par SMS.
OTP_DEBUG_RETURN=true

# Fournisseur SMS : log | none  (brancher ici un agrégateur SMS local)
SMS_PROVIDER=log

# Fournisseur de notifications push : log | none
PUSH_PROVIDER=log

# Paiements : les prestataires électroniques sont branchés via adaptateurs.
# mock = simulateur local pour le développement et les tests.
PAYMENT_MOBILE_MONEY_PROVIDER=mock
PAYMENT_CARD_PROVIDER=mock

# Attribution des courses (§19)
DISPATCH_SEARCH_RADIUS_KM=5
DISPATCH_MAX_CANDIDATES=10
DISPATCH_OFFER_TTL_SECONDS=20

# Devise de la plateforme (FCFA : pas de sous-unité, montants entiers)
CURRENCY=XOF

# Origines autorisées pour l'admin web (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173
